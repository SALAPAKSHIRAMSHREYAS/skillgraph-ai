# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# GitHub Personal Access Token (required for reliable rate limits)
GITHUB_TOKEN=your_github_personal_access_token

# Gemini API Key (optional — LLM evidence step is skipped if absent)
GEMINI_API_KEY=your_gemini_api_key

# CORS — comma-separated list of allowed origins
# Development default: localhost only. Set for production deployment.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment — set to "production" to disable /docs UI
ENV=development

# Analysis tuning
REPOS_FETCH_LIMIT=8
REPOS_ANALYZE_LIMIT=5
COMMITS_PER_REPO=100
MAX_PY_FILES_PER_REPO=10

# LLM prompt size cap (chars) — prevents oversized Gemini token usage
LLM_MAX_METRICS_CHARS=4000

# Per-request audit timeout (seconds)
AUDIT_TIMEOUT_SECONDS=60
